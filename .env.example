# --- Payment wallet (set at least one; keys sign locally, never sent anywhere) ---
# Solana wallet holding USDC + a little SOL (base58 secret key)
SOLANA_PRIVATE_KEY=
# Base (EVM) wallet holding USDC + a little ETH on Base (0x-prefixed hex)
EVM_PRIVATE_KEY=

# --- LLM provider keys (only for the agent examples you run) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Optional overrides ---
# PRETESTADS_SCORE_URL=https://pretestads.com/api/v1/score
